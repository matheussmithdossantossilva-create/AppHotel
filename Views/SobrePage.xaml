<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="AppHotel.Views.SobrePage"
    Title="Sobre"
    BackgroundColor="#101827">

    <VerticalStackLayout
        Padding="30"
        Spacing="20"
        VerticalOptions="Center">

        <Label Text="HOTEL PREMIUM"
               FontSize="28"
               FontAttributes="Bold"
               TextColor="#D6AD60"
               HorizontalOptions="Center"/>

        <BoxView HeightRequest="2"
                 Color="#D6AD60"/>

        <Label Text="Sobre o aplicativo"
               FontSize="23"
               FontAttributes="Bold"
               TextColor="White"
               HorizontalOptions="Center"/>

        <Label Text="Aplicativo de contratação e gerenciamento de hospedagens."
               TextColor="#B8C2D1"
               HorizontalTextAlignment="Center"/>

        <Label Text="Desenvolvedor:"
               TextColor="#D6AD60"
               HorizontalOptions="Center"/>

        <Label Text="Matheus Smith dos Santos Silva"
               TextColor="White"
               HorizontalOptions="Center"
               HorizontalTextAlignment="Center"/>

        <Label Text="Ano de desenvolvimento: 2026"
               TextColor="White"
               HorizontalOptions="Center"/>

        <Label Text=".NET MAUI e C#"
               TextColor="#D6AD60"
               HorizontalOptions="Center"/>

    </VerticalStackLayout>
</ContentPage>
