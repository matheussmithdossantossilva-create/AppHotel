<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="AppHotel.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:AppHotel.Views"
    Title="Hotel Premium"
    Shell.FlyoutBehavior="Disabled"
    Shell.BackgroundColor="#101827"
    Shell.ForegroundColor="#D6AD60"
    Shell.TitleColor="#D6AD60">

    <TabBar>

        <ShellContent
            Title="Contratar"
            Route="ContratacaoHospedagem"
            ContentTemplate="{DataTemplate views:ContratacaoHospedagem}"/>

        <ShellContent
            Title="Hospedagem"
            Route="HospedagemContratada"
            ContentTemplate="{DataTemplate views:HospedagemContratada}"/>

        <ShellContent
            Title="Sobre"
            Route="SobrePage"
            ContentTemplate="{DataTemplate views:SobrePage}"/>

    </TabBar>

</Shell>
